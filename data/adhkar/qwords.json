{"1:1":{"w":[["بِسۡمِ","bis'mi","In (the) name"],["ٱللَّهِ","l-lahi","(of) Allah"],["ٱلرَّحۡمَٰنِ","l-raḥmāni","the Most Gracious"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful"]]},"1:2":{"w":[["ٱلۡحَمۡدُ","al-ḥamdu","All praises and thanks"],["لِلَّهِ","lillahi","(be) to Allah"],["رَبِّ","rabbi","the Lord"],["ٱلۡعَٰلَمِينَ","l-ʿālamīna","of the universe"]]},"1:3":{"w":[["ٱلرَّحۡمَٰنِ","al-raḥmāni","The Most Gracious"],["ٱلرَّحِيمِ","l-raḥīmi","the Most Merciful"]]},"1:4":{"w":[["مَٰلِكِ","māliki","(The) Master"],["يَوۡمِ","yawmi","(of the) Day"],["ٱلدِّينِ","l-dīni","(of the) Judgment"]]},"1:5":{"w":[["إِيَّاكَ","iyyāka","You Alone"],["نَعۡبُدُ","naʿbudu","we worship"],["وَإِيَّاكَ","wa-iyyāka","and You Alone"],["نَسۡتَعِينُ","nastaʿīnu","we ask for help"]]},"1:6":{"w":[["ٱهۡدِنَا","ih'dinā","Guide us"],["ٱلصِّرَٰطَ","l-ṣirāṭa","(to) the path"],["ٱلۡمُسۡتَقِيمَ","l-mus'taqīma","the straight"]]},"1:7":{"w":[["صِرَٰطَ","ṣirāṭa","(The) path"],["ٱلَّذِينَ","alladhīna","(of) those"],["أَنۡعَمۡتَ","anʿamta","You have bestowed (Your) Favors"],["عَلَيۡهِمۡ","ʿalayhim","on them"],["غَيۡرِ","ghayri","not (of)"],["ٱلۡمَغۡضُوبِ","l-maghḍūbi","those who earned (Your) wrath"],["عَلَيۡهِمۡ","ʿalayhim","on themselves"],["وَلَا","walā","and not"],["ٱلضَّآلِّينَ","l-ḍālīna","(of) those who go astray"]]},"2:255":{"w":[["ٱللَّهُ","al-lahu","Allah "],["لَآ","lā","(there is) no"],["إِلَٰهَ","ilāha","God"],["إِلَّا","illā","except"],["هُوَ","huwa","Him"],["ٱلۡحَيُّ","l-ḥayu","the Ever-Living"],["ٱلۡقَيُّومُۚ","l-qayūmu","the Sustainer of all that exists"],["لَا","lā","Not"],["تَأۡخُذُهُۥ","takhudhuhu","overtakes Him"],["سِنَةٞ","sinatun","slumber"],["وَلَا","walā","[and] not"],["نَوۡمٞۚ","nawmun","sleep"],["لَّهُۥ","lahu","To Him (belongs)"],["مَا","mā","what(ever)"],["فِي","fī","(is) in"],["ٱلسَّمَٰوَٰتِ","l-samāwāti","the heavens"],["وَمَا","wamā","and what(ever)"],["فِي","fī","(is) in"],["ٱلۡأَرۡضِۗ","l-arḍi","the earth"],["مَن","man","Who"],["ذَا","dhā","(is) the one"],["ٱلَّذِي","a